# Backend endpoints (the local server from ../sync-draft-server)
VITE_API_ENDPOINT="http://localhost:3030/api"
VITE_SOCKET_ENDPOINT="http://localhost:3030"

# --- Auth0 (Single Page Application) -----------------------------------------
# NOTE: the client wants the BARE HOSTNAME here — no https://, no trailing
# slash. The server's AUTH0_DOMAIN wants the opposite (a full URL). Same tenant,
# two different formats.
#   e.g. your-tenant.au.auth0.com
VITE_AUTH0_DOMAIN=""

# Client ID of the SPA application. Public by design; safe to commit if you want.
VITE_AUTH0_CLIENT_ID=""

# Must be listed in the application's "Allowed Callback URLs".
VITE_AUTH0_CALLBACK_URL="http://localhost:5173/document"

# Must match AUTH0_AUDIENCE on the server EXACTLY. If this is missing or wrong,
# Auth0 returns an opaque token instead of a JWT and every API call 401s.
VITE_AUTH0_AUDIENCE=""
